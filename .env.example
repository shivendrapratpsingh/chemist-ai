# ── Postgres database (get free DB from https://neon.tech) ────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Cloudinary file storage (get free account at https://cloudinary.com) ─────
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@your-cloud-name

# ── Admin session signing secret ──────────────────────────────────────────────
# Generate any long random string — change this before going live!
ADMIN_SECRET=change-this-to-a-long-random-secret-string
